# Normalize line endings: store as LF in git, check out as LF on every platform.
# Prevents Windows (core.autocrlf=true) checkouts from introducing CRLF that
# prettier (endOfLine: "lf") then flags across the whole repo.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
