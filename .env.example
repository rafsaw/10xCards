SUPABASE_URL=###
SUPABASE_KEY=###
OPENROUTER_API_KEY=###
OPENROUTER_MODEL=openai/gpt-4o-mini

# Sentry error monitoring (errors only). DSNs are publishable.
# - PUBLIC_SENTRY_DSN: read at build time and embedded in the browser SDK
#   (sentry.client.config.js). Exposed to the client by design.
# - SENTRY_DSN: server-side Worker secret read by withSentry at runtime
#   (sentry.server.config.ts); store it as a Cloudflare secret in production.
# Leave both unset to disable Sentry locally (init becomes a no-op).
PUBLIC_SENTRY_DSN=###
SENTRY_DSN=###

# Optional — only for the tracker-sync dev hook (.claude/hooks/github-issue-sync.mjs).
# Linear personal API key (Linear → Settings → Security & access → Personal API keys).
# Without it, `npm run sync:issues` syncs GitHub only and skips Linear.
LINEAR_API_KEY=###