SUPABASE_URL=###
SUPABASE_KEY=###
OPENROUTER_API_KEY=###
OPENROUTER_MODEL=openai/gpt-4o-mini

# Sentry error monitoring (errors only). DSNs are publishable; both vars may hold the SAME value.
# - PUBLIC_SENTRY_DSN: BUILD-TIME. Inlined into the browser bundle by `astro build`
#   (sentry.client.config.ts). Set it in the build environment (e.g. .env.production / CI),
#   NOT as a Cloudflare runtime var — it is baked in before the Worker runs.
# - SENTRY_DSN: RUNTIME. Read per request by withSentry in the Worker (sentry.server.config.ts);
#   store it as a Cloudflare Worker secret in production (`wrangler secret put SENTRY_DSN`).
# Leave both unset to disable Sentry locally (init becomes a no-op). See README → Deployment.
PUBLIC_SENTRY_DSN=###
SENTRY_DSN=###

# Optional — only for the tracker-sync dev hook (.claude/hooks/github-issue-sync.mjs).
# Linear personal API key (Linear → Settings → Security & access → Personal API keys).
# Without it, `npm run sync:issues` syncs GitHub only and skips Linear.
LINEAR_API_KEY=###