{
  "name": "@10xcards/code-reviewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AI-assisted code reviewer sub-app (AI SDK + OpenRouter + zod).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "ci": "tsx src/ci.ts",
    "check": "tsx src/check.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "eval": "promptfoo eval -c promptfooconfig.yaml",
    "eval:view": "promptfoo view"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.212",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "promptfoo": "^0.121.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
