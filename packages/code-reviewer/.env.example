# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Optional: override the model. Browse ids at https://openrouter.ai/models
# Defaults to anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
