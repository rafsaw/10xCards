+function NotificationsPanel({ channel, initialFilter = "all" }) {
+  const [items, setItems] = useState([]);
+  const [unread, setUnread] = useState(0);
+  const [filter, setFilter] = useState(initialFilter);
+  const panelRoot = useRef(null);
+
+  const handleIncoming = useCallback((notification) => {
+    setItems((prev) => [notification, ...prev].slice(0, 50));
+    setUnread((prev) => prev + 1);
+  }, []);
+
+  // Subscribe to the live notification stream for the current channel.
+  useEffect(() => {
+    const unsubscribe = notificationBus.subscribe(channel, handleIncoming);
+  }, [channel, handleIncoming]);
+
+  const markAllRead = useCallback(() => setUnread(0), []);
