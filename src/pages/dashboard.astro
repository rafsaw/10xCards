---
import Layout from "@/layouts/Layout.astro";
import DashboardLead from "@/components/dashboard/DashboardLead.astro";
import DashboardNote from "@/components/dashboard/DashboardNote.astro";
import { buttonVariants } from "@/components/ui/button";
import { Notice } from "@/components/ui/Notice";
import { PageHeader } from "@/components/ui/PageHeader";
import { createClient } from "@/lib/supabase";
import {
  alsoWaitingSentence,
  draftsWaitingSentence,
  dueSentence,
  librarySentence,
  resolveDashboardState,
} from "@/lib/dashboard-state";

// The dashboard answers "what should I do now?" from three counts the app already
// gathers elsewhere. All three resolve on the server before the first byte reaches
// the browser (`output: "server"`), so there is deliberately no loading state, no
// skeleton and no `client:` island here — if a count ever feels slow, the fix is the
// query, not a placeholder.
//
// No `user_id` filter on any query: row-level security scopes every read to the
// signed-in user in the database. Verified for this change against
// supabase/migrations/20260527150510_cards_and_account_deletion.sql:36-40 —
// `enable row level security` plus `cards_select_own … using ((select auth.uid()) = user_id)`,
// the only SELECT policy on the table — reached through the app's single anon-key
// client (src/lib/supabase.ts), whose `authenticated` role does not own the table and
// so cannot bypass the policy. `head: true` sends no rows over the wire, only the count.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { isReadOnly } = Astro.locals;

let dueCount = 0;
let draftCount = 0;
let libraryCount = 0;
let loadError = false;

if (supabase) {
  const nowIso = new Date().toISOString();

  // The catch matters: PostgREST problems come back as `{ error }` and are handled
  // below, but a transport-level failure (DNS, TLS, a dropped connection to
  // Supabase) *throws*. Uncaught, that would turn the page every login lands on
  // into a 500 — strictly worse than the error state this screen was designed to
  // show, which keeps review, generate and library reachable.
  try {
    // Same predicates as the pages that own each of these numbers: review.astro for
    // due cards, generate.astro for drafts, library.astro for the saved deck.
    const [due, drafts, library] = await Promise.all([
      supabase
        .from("cards")
        .select("id", { count: "exact", head: true })
        .eq("status", "saved")
        .lte("next_due_at", nowIso),
      supabase.from("cards").select("id", { count: "exact", head: true }).eq("status", "draft"),
      supabase.from("cards").select("id", { count: "exact", head: true }).eq("status", "saved"),
    ]);

    // Never render a zero that came from a failed query: "0 cards are due for review"
    // after a failed count is a lie that stops someone from studying.
    if (due.error || drafts.error || library.error) {
      loadError = true;
    } else {
      dueCount = due.count ?? 0;
      draftCount = drafts.count ?? 0;
      libraryCount = library.count ?? 0;
    }
  } catch {
    loadError = true;
  }
}

const state = resolveDashboardState({
  configured: supabase !== null,
  loadError,
  isReadOnly,
  dueCount,
  draftCount,
  libraryCount,
});

const libraryText = "libraryCount" in state && state.libraryCount !== null ? librarySentence(state.libraryCount) : null;

// Two tiers, and only two, after the UX review of PR #31 (findings 1 and 2). The
// review measured every section rendering at an identical 20px/600 heading inside an
// identical card, with a 30%-opacity gradient on one button as the sole cue that
// anything outranked anything else — so "Next up" did not read as the answer to "what
// now?". That requirement still holds; only its expression changed. Paper has no glass,
// no gradient and no panel-as-elevation, so the two tiers now live in
// `DashboardLead` (the answer, with the page's single filled button) and
// `DashboardNote` (hairline-separated context, never a peer). See
// .ai/specs/2026-08-26-screen-migration-dashboard.md.
---

<Layout title="Dashboard">
  <div class="bg-background text-foreground min-h-screen p-4">
    <div class="max-w-content mx-auto space-y-6 py-8">
      <PageHeader title="Dashboard" />

      {
        state.kind === "not-configured" && (
          <Notice variant="error">Supabase is not configured — your dashboard cannot be loaded.</Notice>
        )
      }

      {
        state.kind === "error" && (
          <>
            {/* The message precedes the links so it is read before the choices it qualifies.
                Three plain links, as the brief specifies: no count survived the failure, so
                nothing here outranks anything else and none of them is dressed as a primary. */}
            <Notice variant="error">We couldn't load your dashboard right now. Try refreshing the page.</Notice>
            <div class="flex flex-wrap items-center gap-3">
              <a href="/review" class="text-link text-sm underline underline-offset-4">
                Start review session
              </a>
              <a href="/generate" class="text-link text-sm underline underline-offset-4">
                Generate cards
              </a>
              <a href="/library" class="text-link text-sm underline underline-offset-4">
                Browse library
              </a>
            </div>
          </>
        )
      }

      {
        state.kind === "read-only" && (
          <>
            <Notice variant="warning" title="Your account is read-only" titleAs="h2">
              While deletion is pending you can browse your cards, but you can't review, generate, or edit them. Cancel
              the deletion in the banner above to continue.
            </Notice>

            {/* Browsing is the one thing still available. When the library note below
                renders it already carries this link, so it is not repeated here.
                Rendered as a sibling rather than through Notice's `action` prop: an
                Astro template cannot pass markup in a component attribute (esbuild
                rejects `action={<a href=…>}`), and the alternative — a React wrapper
                island purely to hold one static link — would put a `client:` directive
                on a page the spec keeps island-free. */}
            {libraryText === null && (
              <div class="flex flex-wrap items-center gap-3">
                <a href="/library" class="text-link text-sm underline underline-offset-4">
                  Browse library
                </a>
              </div>
            )}
          </>
        )
      }

      {
        state.kind === "review-waiting" && (
          <>
            <DashboardLead label="Next up" statement={dueSentence(state.dueCount)}>
              <a href="/review" class:list={buttonVariants()}>
                Start review session
              </a>
            </DashboardLead>

            {/* Subordinate by construction: a hairline, a quiet eyebrow and a text link.
                Drafts are the reminder, never a second primary action competing with the
                review. */}
            {state.alsoWaitingDrafts !== null && (
              <DashboardNote label="Also waiting">
                {alsoWaitingSentence(state.alsoWaitingDrafts)}{" "}
                <a href="/generate" class="text-link text-sm underline underline-offset-4">
                  Check generated cards
                </a>
              </DashboardNote>
            )}
          </>
        )
      }

      {
        state.kind === "drafts-waiting" && (
          <DashboardLead label="Next up" statement={draftsWaitingSentence(state.draftCount)}>
            <a href="/generate" class:list={buttonVariants()}>
              Check generated cards
            </a>
          </DashboardLead>
        )
      }

      {
        state.kind === "caught-up" && (
          /* "Browse library" is the library note's link — this state always has a
             library, so offering it twice would be one action too many. */
          <DashboardLead
            label="All caught up"
            statement="Nothing is due right now. Cards come back when their interval is up."
          >
            <a href="/generate" class:list={buttonVariants()}>
              Generate more cards
            </a>
          </DashboardLead>
        )
      }

      {
        state.kind === "new-account" && (
          <DashboardLead
            label="Start your first deck"
            statement="You have no cards yet. Paste a passage and 10xCards drafts question-and-answer cards for you to review before anything is saved."
          >
            <a href="/generate" class:list={buttonVariants()}>
              Create your first cards
            </a>
            <a href="/library" class="text-link text-sm underline underline-offset-4">
              Or add a card by hand
            </a>
          </DashboardLead>
        )
      }

      {
        /* Context, not an action — the brief's words. One sentence and one plain link,
          with no card and no button, so it cannot read as a peer of whatever the state
          above is asking the user to do. */
      }
      {
        libraryText !== null && (
          <DashboardNote label="Your library">
            {libraryText}{" "}
            <a href="/library" class="text-link text-sm underline underline-offset-4">
              Browse library
            </a>
          </DashboardNote>
        )
      }
    </div>
  </div>
</Layout>
