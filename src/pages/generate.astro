---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import PasteAndGenerateForm from "@/components/generate/PasteAndGenerateForm";
import DraftReviewList from "@/components/generate/DraftReviewList";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { isReadOnly } = Astro.locals;

interface DraftRow {
  id: string;
  front: string;
  back: string;
  created_at: string;
}

let drafts: DraftRow[] = [];
let loadError = false;

if (supabase) {
  const { data, error } = await supabase
    .from("cards")
    .select("id, front, back, created_at")
    .eq("status", "draft")
    .order("created_at", { ascending: false })
    .overrideTypes<DraftRow[], { merge: false }>();
  if (error) {
    loadError = true;
  } else {
    drafts = data;
  }
}
---

<Layout title="Generate cards">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl space-y-6 py-8">
      <header class="flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Generate cards
        </h1>
        <a href="/dashboard" class="text-sm text-blue-100/70 transition-colors hover:text-white">← Dashboard</a>
      </header>

      {
        !supabase && (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
            Supabase is not configured — drafts cannot be loaded.
          </p>
        )
      }

      {
        loadError && (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
            Could not load your drafts. Try refreshing the page.
          </p>
        )
      }

      {
        isReadOnly ? (
          <section class="space-y-4 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
            <h2 class="text-xl font-semibold">Generate new cards from text</h2>
            <p class="rounded-lg border border-amber-500/30 bg-amber-900/20 px-3 py-2 text-sm text-amber-200">
              Your account is pending deletion and is read-only. Cancel the deletion to generate cards.
            </p>
          </section>
        ) : (
          <>
            {drafts.length > 0 && <DraftReviewList client:load drafts={drafts} />}

            <section class="space-y-4 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
              <h2 class="text-xl font-semibold">Generate new cards from text</h2>
              <PasteAndGenerateForm client:load />
            </section>
          </>
        )
      }
    </div>
  </div>
</Layout>
