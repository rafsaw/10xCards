---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { PageHeader } from "@/components/ui/PageHeader";
import { Notice } from "@/components/ui/Notice";
import { Section } from "@/components/ui/Section";
import PasteAndGenerateForm from "@/components/generate/PasteAndGenerateForm";
import DraftReviewList from "@/components/generate/DraftReviewList";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { isReadOnly } = Astro.locals;

interface DraftRow {
  id: string;
  front: string;
  back: string;
  created_at: string;
}

let drafts: DraftRow[] = [];
let loadError = false;

if (supabase) {
  const { data, error } = await supabase
    .from("cards")
    .select("id, front, back, created_at")
    .eq("status", "draft")
    .order("created_at", { ascending: false })
    .overrideTypes<DraftRow[], { merge: false }>();
  if (error) {
    loadError = true;
  } else {
    drafts = data;
  }
}
---

<Layout title="Generate cards">
  <div class="bg-background text-foreground min-h-screen p-4">
    <div class="max-w-content mx-auto space-y-6 py-8">
      <PageHeader title="Generate cards" />

      {!supabase && <Notice variant="error">Supabase is not configured — drafts cannot be loaded.</Notice>}

      {loadError && <Notice variant="error">Could not load your drafts. Try refreshing the page.</Notice>}

      {
        isReadOnly ? (
          <Section title="Generate new cards from text">
            <Notice variant="warning">
              Your account is pending deletion and is read-only. Cancel the deletion to generate cards.
            </Notice>
          </Section>
        ) : (
          <>
            {drafts.length > 0 && <DraftReviewList client:load drafts={drafts} />}

            <PasteAndGenerateForm client:load primary={drafts.length === 0} />
          </>
        )
      }
    </div>
  </div>
</Layout>
