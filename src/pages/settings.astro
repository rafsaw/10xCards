---
import Layout from "@/layouts/Layout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import DeleteAccountButton from "@/components/settings/DeleteAccountButton";
import RetentionNotice from "@/components/settings/RetentionNotice";
import { formatRetentionDate } from "@/lib/account-retention";

const { user, isReadOnly, retentionUntil } = Astro.locals;
const formatted = formatRetentionDate(retentionUntil);
---

<Layout title="Settings">
  <div class="bg-background text-foreground min-h-screen p-4">
    <div class="max-w-content mx-auto space-y-8 py-8">
      <PageHeader title="Settings" />

      <p class="text-muted-foreground text-sm">
        Signed in as <span class="text-foreground font-semibold">{user?.email}</span>
      </p>

      <div class="border-border space-y-3 border-t pt-6">
        <div>
          <h2 class="text-title text-destructive font-semibold">Danger zone</h2>
          <p class="text-muted-foreground mt-1 text-sm">
            Deleting your account starts a 30-day retention window. During that time your account stays read-only and
            you can cancel any time. After it elapses, your account and all your cards are permanently deleted.
          </p>
        </div>

        {isReadOnly ? <RetentionNotice client:load formatted={formatted} /> : <DeleteAccountButton client:load />}
      </div>
    </div>
  </div>
</Layout>
