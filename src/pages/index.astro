---
import Layout from "@/layouts/Layout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import { buttonVariants } from "@/components/ui/button";

if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}
---

{/* A gateway, not a landing page. The product's v1 audience is one person dogfooding,
    so positioning copy for an audience of one is work nobody asked for; what a
    signed-out visitor needs here is the name, one sentence naming the job, and a way
    in. The description is a placeholder by construction — it lives on exactly one line
    in exactly one file, and anyone with a better one overwrites it without ceremony.

    No island: `<a class:list={buttonVariants()}>` is the link-as-button pattern
    dashboard.astro already uses, chosen over `<Button asChild>` because the latter
    would drag React onto a static page. */}
<Layout>
  <div class="bg-background text-foreground min-h-screen p-4">
    <div class="max-w-content mx-auto space-y-6 py-8">
      <PageHeader title="10xCards" description="Paste what you're reading. Keep the cards worth keeping." />
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/auth/signin" class:list={buttonVariants()}>Sign in</a>
        <a href="/auth/signup" class:list={buttonVariants({ variant: "outline" })}>Create account</a>
      </div>
    </div>
  </div>
</Layout>
