---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import CreateCardForm from "@/components/library/CreateCardForm";
import CardList from "@/components/library/CardList";
import LibrarySearch from "@/components/library/LibrarySearch.astro";
import { LibraryEmpty } from "@/components/library/LibraryEmpty";
import { Notice } from "@/components/ui/Notice";
import { PageHeader } from "@/components/ui/PageHeader";
import { Section } from "@/components/ui/Section";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { isReadOnly } = Astro.locals;

const PAGE_SIZE = 20;

interface SavedCard {
  id: string;
  front: string;
  back: string;
}

const rawPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const q = (Astro.url.searchParams.get("q") ?? "").trim();
// Strip characters that would break the PostgREST `.or()` filter string.
const safeQ = q.replace(/[,()"]/g, " ").trim();

const buildHref = (p: number) => {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  return qs ? `/library?${qs}` : "/library";
};

const orFilter = safeQ ? `front.ilike.%${safeQ}%,back.ilike.%${safeQ}%` : null;

let cards: SavedCard[] = [];
let loadError = false;
let totalCount = 0;

if (supabase) {
  // Count first so we can clamp out-of-range page requests to the last page.
  let countQuery = supabase.from("cards").select("id", { count: "exact", head: true }).eq("status", "saved");
  if (orFilter) {
    countQuery = countQuery.or(orFilter);
  }
  const { count, error: countError } = await countQuery;
  if (countError) {
    loadError = true;
  } else {
    totalCount = count ?? 0;
  }
}

const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const lastPage = totalPages;
const effectivePage = page > lastPage ? lastPage : page;
const shouldFixPageUrl = !loadError && supabase && page > lastPage;

if (supabase && !loadError) {
  const offset = (effectivePage - 1) * PAGE_SIZE;
  let query = supabase.from("cards").select("id, front, back").eq("status", "saved");
  if (orFilter) {
    query = query.or(orFilter);
  }
  const { data, error } = await query
    .order("created_at", { ascending: false })
    .range(offset, offset + PAGE_SIZE - 1)
    .overrideTypes<SavedCard[], { merge: false }>();
  if (error) {
    loadError = true;
  } else {
    cards = data;
  }
}

const hasPrev = effectivePage > 1;
const hasNext = effectivePage < totalPages;
---

<Layout title="Card library">
  {
    shouldFixPageUrl && (
      <script is:inline define:vars={{ href: buildHref(lastPage) }}>
        window.history.replaceState(null, "", href);
      </script>
    )
  }
  <div class="bg-background text-foreground min-h-screen p-4">
    <div class="mx-auto max-w-3xl space-y-8 py-8">
      <PageHeader title="Card library" />

      {!supabase && <Notice variant="error">Supabase is not configured — your library cannot be loaded.</Notice>}

      {loadError && <Notice variant="error">Could not load your cards. Try refreshing the page.</Notice>}

      <Section title="Create a card">
        {
          isReadOnly ? (
            <Notice variant="warning">
              Your account is pending deletion and is read-only. Cancel the deletion to create cards.
            </Notice>
          ) : (
            <CreateCardForm client:load />
          )
        }
      </Section>

      {
        cards.length > 0 ? (
          <Section title={`Saved cards (${totalCount})`}>
            <LibrarySearch q={q} />
            <CardList client:load cards={cards} readOnly={isReadOnly} />
            {totalPages > 1 && (
              <nav class="flex items-center justify-between pt-2 text-sm" aria-label="Library pagination">
                {hasPrev ? (
                  <a href={buildHref(effectivePage - 1)} class="text-link text-sm underline underline-offset-4">
                    ← Previous
                  </a>
                ) : (
                  <span class="text-muted-foreground text-sm" aria-disabled="true">
                    ← Previous
                  </span>
                )}
                <span class="text-muted-foreground">
                  Page {effectivePage} of {totalPages}
                </span>
                {hasNext ? (
                  <a href={buildHref(effectivePage + 1)} class="text-link text-sm underline underline-offset-4">
                    Next →
                  </a>
                ) : (
                  <span class="text-muted-foreground text-sm" aria-disabled="true">
                    Next →
                  </span>
                )}
              </nav>
            )}
          </Section>
        ) : q ? (
          <div class="space-y-4">
            <LibrarySearch q={q} />
            <LibraryEmpty q={q} />
          </div>
        ) : (
          <LibraryEmpty />
        )
      }
    </div>
  </div>
</Layout>
