---
import { CircleCheck, Mail } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };

/* The emoji this replaces (✅ / 📧) had two problems a colour swap would not have fixed:
   a screen reader announces it by name where a decorative glyph should be silent
   (WCAG 1.1.1), and it renders in the platform's colour emoji font — exactly the
   saturated decoration principle 6 rules out. */
const Icon = isAutoConfirmed ? CircleCheck : Mail;
---

<Layout title={content.heading}>
  <AuthCard title={content.heading}>
    <Icon aria-hidden="true" className="text-muted-foreground mb-4 size-8" />
    <p class="text-body text-muted-foreground mb-6">{content.description}</p>
    <a href="/auth/signin" class="text-link text-sm underline underline-offset-4">
      {content.linkText}
    </a>
  </AuthCard>
</Layout>
