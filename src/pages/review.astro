---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { PageHeader } from "@/components/ui/PageHeader";
import { Notice } from "@/components/ui/Notice";
import ReviewSession from "@/components/review/ReviewSession";
import type { DueCard } from "@/components/review/ReviewSession";
// PROTOTYPE (issue #71) — throwaway, do not merge to main. `?variant=A|B|C`
// swaps the rating UI for one of three prototype variants; ratings are stubbed
// in memory there, so nothing is written.
import ReviewSessionPrototype from "@/components/review/prototype/ReviewSessionPrototype";

const prototypeVariant = Astro.url.searchParams.get("variant");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { isReadOnly } = Astro.locals;

let dueCards: DueCard[] = [];
let loadError = false;

if (supabase) {
  const { data, error } = await supabase
    .from("cards")
    .select("id, front, back, tag, box")
    .eq("status", "saved")
    .lte("next_due_at", new Date().toISOString())
    .order("next_due_at", { ascending: true })
    .order("last_reviewed_at", { ascending: true, nullsFirst: true })
    .overrideTypes<DueCard[], { merge: false }>();
  if (error) {
    loadError = true;
  } else {
    dueCards = data;
  }
} else {
  loadError = true;
}
---

<Layout title="Review session">
  <div class="bg-background text-foreground min-h-screen p-4">
    <div class="max-w-content mx-auto space-y-6 py-8">
      <PageHeader title="Review session" />

      {
        /* No `Section` wrapper here, deliberately diverging from /generate: there the warning replaced
           one of two sibling regions, so it needed a title to stay distinguishable. /review has a single
           region, and a Section whose title repeated the page's own h1 would be chrome that enables
           nothing — principle 3. */
      }
      {
        prototypeVariant ? (
          <ReviewSessionPrototype
            client:load
            variant={prototypeVariant}
            dueCards={dueCards.map((c) => ({ id: c.id, front: c.front, back: c.back, tag: c.tag }))}
          />
        ) : isReadOnly ? (
          <Notice variant="warning">
            Your account is pending deletion and is read-only. Cancel the deletion to review cards.
          </Notice>
        ) : (
          <ReviewSession client:load dueCards={dueCards} loadError={loadError} />
        )
      }
    </div>
  </div>
</Layout>
