---
/**
 * The shared shell for the three auth screens: a full-bleed centring wrapper, one
 * hairline card at the reading width, the page `h1`, and a default slot.
 *
 * Page-local to the auth family on purpose — it lives in `components/auth/`, not in
 * `components/ui/`. It has three consumers, all in one folder, and promoting it to the
 * registry would assert a generality it does not have. That mirrors where Increment 8
 * put `DashboardLead.astro` and `DashboardNote.astro`.
 *
 * `--card` resolves to `--ink-05`, the same value as `--background`, so the card is
 * separated from the page by its hairline and its whitespace alone. That is principle 4,
 * and it is why no shadow appears here.
 *
 * No `footer` slot: `/auth/confirm-email` has no footer of the shape the other two share,
 * so two of three consumers would use it and the third would pass nothing. Named slots
 * earn their place at three consumers, not two — the footer stays in the page, one line
 * each.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="bg-background text-foreground flex min-h-screen items-center justify-center p-4">
  <div class="border-border bg-card rounded-paper w-full max-w-sm border p-8">
    <h1 class="text-display text-foreground mb-6 font-sans font-bold">{title}</h1>
    <slot />
  </div>
</div>
