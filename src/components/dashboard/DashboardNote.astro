---
/**
 * The dashboard's tier-2 recipe: the reminder and the context, subordinate by
 * construction.
 *
 * The hairline is what separates a note from the lead, and it is the only separator on
 * the page — one border token, no surface fill and no shadow anywhere (principle 4).
 *
 * The eyebrow is an `<h3>`, one level below `DashboardLead`'s statement `<h2>`, so the
 * note reads as subordinate in the document outline and not as a peer — which is the
 * whole point of the two tiers. The class list is the lead eyebrow's verbatim, so the
 * level change is invisible on screen. No state renders a note without a lead or a
 * `Notice` heading above it, so no heading level is ever skipped.
 * The body and its link go in the slot; the link recipe is underlined so it is
 * identifiable without colour (WCAG 2.2 §1.4.1).
 *
 * Source: .ai/specs/2026-08-26-screen-migration-dashboard.md
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section class="border-border space-y-1 border-t pt-4">
  <h3 class="text-meta text-muted-foreground font-sans tracking-wide uppercase">{label}</h3>
  <p class="text-muted-foreground text-sm"><slot /></p>
</section>
