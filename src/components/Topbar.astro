---
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/generate", label: "Generate" },
  { href: "/review", label: "Review" },
  { href: "/library", label: "Library" },
  { href: "/dashboard", label: "Dashboard" },
];

const isActive = (href: string) => pathname === href || pathname === `${href}/`;
const navItemBase = "rounded-lg px-3 py-1.5 transition-colors";
const linkClass = (href: string) =>
  isActive(href)
    ? `${navItemBase} bg-white/15 text-white`
    : `${navItemBase} text-blue-100/70 hover:bg-white/10 hover:text-white`;
---

<div
  class="mb-4 flex flex-wrap items-center justify-between gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <nav class="flex flex-wrap items-center gap-1 sm:gap-2">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={linkClass(link.href)}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg px-3 py-1.5 text-blue-100/70 transition-colors hover:bg-white/10 hover:text-white"
            >
              Sign out
            </button>
          </form>
        </nav>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
