{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint",
            "timeout": 120,
            "statusMessage": "Linting after edit…"
          },
          {
            "type": "command",
            "command": "npm run typecheck",
            "timeout": 30000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/roadmap-drift-check.mjs",
            "timeout": 15,
            "statusMessage": "Checking roadmap.md sync…"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/github-issue-sync.mjs --check",
            "timeout": 15,
            "statusMessage": "Checking tracker sync…"
          }
        ]
      }
    ]
  }
}
